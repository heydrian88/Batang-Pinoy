rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Customer orders: anyone can submit, only the logged-in admin can view/edit/delete
    match /registrations/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Products shown on the main page: everyone can view, only admin can change
    match /products/{id} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // GCash payment details: everyone can view, only admin can change
    match /settings/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
